{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "lib": ["dom", "webworker"],
    "outDir": "./public",
    "rootDir": "./service-worker",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "removeComments": true
  },
  "include": ["service-worker/**/*.ts"],
  "exclude": ["node_modules"]
}