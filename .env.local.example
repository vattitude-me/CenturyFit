# Supabase (from https://supabase.com/dashboard/project/xummgwwdprjeolqcbsul/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xummgwwdprjeolqcbsul.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<get_from_supabase_api_settings>
SUPABASE_SERVICE_ROLE_KEY=<get_from_supabase_api_settings>

# Clerk (from https://dashboard.clerk.com/apps/app_3IksLw6M76VHIReU2tLu4ZR7Bbv/api-keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<get_from_clerk_api_keys>
CLERK_SECRET_KEY=<get_from_clerk_api_keys>
CLERK_WEBHOOK_SECRET=<get_from_clerk_webhooks_after_creating_endpoint>

# VAPID (generate once with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<generate_with_web_push>
VAPID_PRIVATE_KEY=<generate_with_web_push>
VAPID_SUBJECT=mailto:admin@centuryfit.app

# Cron protection (generate random 64-char string)
CRON_SECRET=<generate_random_string>

# Service worker cache version (bump on deploy)
NEXT_PUBLIC_CACHE_VERSION=1