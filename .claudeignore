# Large files and directories to skip in Claude context
node_modules/
.next/
.git/
dist/
build/
coverage/
*.log
.DS_Store
.env
.env.local
*.pem

# IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Test outputs
__pycache__/
*.pyc

# Package manager locks (can be large)
package-lock.json
yarn.lock
pnpm-lock.yaml
